<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SQL Template Generator</title>
    
    <!-- Google Fonts: Outfit (Headings), Inter (Body), JetBrains Mono (Code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Outfit:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="app-navbar">
        <div class="nav-content">
            <a asp-controller="Home" asp-action="Index" class="nav-brand">
                <div class="brand-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                    </svg>
                </div>
                <span class="brand-text">Template Builder</span>
            </a>
            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    Template Generator
                </a>
                <a asp-controller="TraceFounder" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TraceFounder" ? "active" : "")">
                    Trace Founder
                </a>
            </div>
        </div>
    </nav>
    
    <!-- Toast Container -->
    <div id="toastContainer" class="toast-container" aria-live="polite"></div>

    <!-- Main Content -->
    <main class="main-content" role="main">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/toastManager.js" asp-append-version="true"></script>
    <script src="~/js/constants.js" asp-append-version="true"></script>
    <script src="~/js/apiClient.js" asp-append-version="true"></script>
    <script src="~/js/validator.js" asp-append-version="true"></script>
    <script src="~/js/uiManager.js" asp-append-version="true"></script>
    <script src="~/js/templateGenerator.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            @if (TempData["Error"] != null)
            {
                <text>
                    setTimeout(function() {
                        if (typeof toastManager !== 'undefined') {
                            toastManager.showError('@Html.Raw(TempData["Error"]?.ToString().Replace("'", "\\'"))', 'Error', 8000);
                        } else {
                            console.error('ToastManager not loaded. Error: @Html.Raw(TempData["Error"]?.ToString().Replace("'", "\\'"))');
                        }
                    }, 100);
                </text>
            }

            @if (TempData["Success"] != null)
            {
                <text>
                    setTimeout(function() {
                        if (typeof toastManager !== 'undefined') {
                            toastManager.showSuccess('@Html.Raw(TempData["Success"]?.ToString().Replace("'", "\\'"))', 'Success', 5000);
                        } else {
                            console.log('Success: @Html.Raw(TempData["Success"]?.ToString().Replace("'", "\\'"))');
                        }
                    }, 100);
                </text>
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>