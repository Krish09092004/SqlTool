@model Template_Builder.Models.ViewModels.TemplateViewModel
@{
    ViewData["Title"] = "Trace Founder";
}

<div class="app-container">
    <!-- Hero Section -->
    <header class="hero-section" style="margin: 3rem 0 4rem; padding: 0;">
        <div class="hero-content">
            <div class="hero-icon" style="width: 72px; height: 72px; margin-bottom: 1.5rem; background: rgba(52, 211, 153, 0.1); border-color: rgba(52, 211, 153, 0.2); color: #34d399; box-shadow: 0 0 40px -10px rgba(52, 211, 153, 0.3);">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 36px; height: 36px;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
            </div>
            <h1 class="hero-title" style="font-size: 2.5rem; margin-bottom: 0.75rem;">Trace Founder</h1>
            <p class="hero-subtitle" style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto;">Live SQL profiling and query analysis.</p>
        </div>
    </header>

    <!-- Configuration Card -->
    <section class="main-card">
        <div class="card-header" style="padding: 2rem 3rem; background: rgba(15, 23, 42, 0.4);">
             <h2 class="card-title" style="font-size: 1.5rem; margin-bottom: 0.5rem;">Trace Configuration</h2>
             <p class="card-subtitle">Select target and apply filters.</p>
        </div>
        <div class="card-body" style="padding: 3rem;">
            <div class="form-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; align-items: start;">
                <!-- Server (Reused) -->
                <div class="form-group">
                    <label for="serverDropdown" class="form-label form-label-required">Server</label>
                    <div class="input-wrapper">
                        <select id="serverDropdown" class="form-select">
                            <option value="">Select Server...</option>
                            @foreach (var server in Model.Servers)
                            {
                                <option value="@server.Name">@server.Name</option>
                            }
                        </select>
                         <div class="input-icon">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Database -->
                <div class="form-group">
                    <label for="databaseDropdown" class="form-label">Database (Optional)</label>
                    <div class="input-wrapper">
                        <select id="databaseDropdown" class="form-select" disabled>
                            <option value="">Select Server First...</option>
                        </select>
                         <div class="input-icon">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Trace Template -->
                <div class="form-group">
                    <label for="traceType" class="form-label">Trace Template</label>
                    <div class="input-wrapper">
                        <select id="traceType" class="form-select">
                            <option value="query">Standard Query Trace (Live)</option>
                            <option value="procedures">Stored Procedures (Live)</option>
                            <option value="long_running">Long Running Queries (> 1s)</option>
                            <option value="high_cpu">High CPU Usage (Top 50)</option>
                            <option value="high_reads">High Logical Reads (Top 50)</option>
                        </select>
                         <div class="input-icon">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="form-hint" style="font-size: 0.8rem; margin-top: 0.5rem; color: var(--text-tertiary);">
                        Select 'Stored Procedures' to see Name, Params & CPU.
                    </div>
                </div>

                <!-- SP Filter -->
                <div class="form-group">
                    <label for="spFilter" class="form-label">Stored Procedure / Text</label>
                    <input type="text" id="spFilter" class="form-input" placeholder="Filter by name...">
                </div>
            </div>

            <!-- Toggles / Filters -->
            <div style="margin-top: 2rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05);">
                <h4 style="font-size: 1rem; color: var(--text-main); margin-bottom: 1rem;">Trace Filters</h4>
                <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
                    <!-- Toggle 1 -->
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <label class="toggle-switch">
                            <input type="checkbox" id="filterDuration">
                            <span class="slider"></span>
                        </label>
                        <span class="toggle-label">Duration > 1s</span>
                    </div>

                    <!-- Toggle 2 -->
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <label class="toggle-switch toggle-success">
                            <input type="checkbox" id="filterReads">
                            <span class="slider"></span>
                        </label>
                        <span class="toggle-label">High Reads (>1000)</span>
                    </div>

                    <!-- Toggle 3 -->
                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <label class="toggle-switch">
                            <input type="checkbox" id="filterSystem">
                            <span class="slider"></span>
                        </label>
                        <span class="toggle-label">Exclude System</span>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="button-group" style="justify-content: flex-start; gap: 1rem; margin-top: 2.5rem;">
                <button type="button" id="startTraceBtn" class="btn btn-primary" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); width: auto; min-width: 140px;">
                    <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Start Trace
                </button>
                <button type="button" id="stopTraceBtn" class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.1); color: var(--error-color); width: auto; display: none;">
                    <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"></path>
                    </svg>
                    Stop Trace
                </button>
                <button type="button" id="resetTraceBtn" class="btn btn-secondary" style="width: auto;">
                    Reset
                </button>
            </div>
        </div>
    </section>

    <style>
        /* Disabled Input Styling */
        .form-select:disabled, 
        .form-input:disabled {
            cursor: not-allowed;
            opacity: 0.6;
            background-color: rgba(15, 23, 42, 0.4);
        }
    </style>

    <!-- Results Table -->
    <section id="traceResults" class="results-section" style="margin-top: 2rem; display: none;">
        <div class="results-card" style="padding: 0;">
            <div class="results-header" style="flex-wrap: wrap; gap: 1rem;">
                <div style="flex: 1; min-width: 200px;">
                    <h3 class="results-title">
                        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                        </svg>
                        Live Events
                    </h3>
                </div>
                
                <!-- Client Side Filter -->
                <div style="position: relative; width: 300px;">
                     <input type="text" id="clientResultFilter" class="form-input" placeholder="Search in results..." style="padding-top: 0.5rem; padding-bottom: 0.5rem; font-size: 0.9rem;">
                     <div class="input-icon">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>

                <span id="eventCountBadge" class="results-badge">0 Events</span>
            </div>
            <div style="overflow-x: auto; max-height: 600px; overflow-y: auto;" id="tableContainer">
                <table style="width: 100%; text-align: left; border-collapse: collapse; color: var(--text-secondary); font-size: 0.9rem;">
                    <thead style="background: rgba(0,0,0,0.2); font-weight: 600; color: var(--primary-light); position: sticky; top: 0; background-color: #1a2234; z-index: 10;">
                        <tr>
                            <th style="padding: 1rem;">Time</th>
                            <th style="padding: 1rem;">Event</th>
                            <th style="padding: 1rem;">Database</th>
                            <th style="padding: 1rem;">Text</th>
                            <th style="padding: 1rem; text-align: right;">Duration</th>
                        </tr>
                    </thead>
                    <tbody id="traceTableBody">
                    </tbody>
                </table>
                <div id="noEventsMsg" style="padding: 2rem; text-align: center; color: var(--text-tertiary); display: none;">
                    No events captured yet. Waiting for queries...
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let traceInterval = null;
            let isTracing = false;
            let eventCount = 0;
            let lastFetchTime = new Date().toISOString(); 

            // Server Change -> Load Databases
            $('#serverDropdown').change(function() {
                const server = $(this).val();
                const dbDropdown = $('#databaseDropdown');
                
                dbDropdown.html('<option value="">Loading...</option>').prop('disabled', true);
                
                if (server) {
                    $.get('@Url.Action("GetDatabases", "TraceFounder")', { serverName: server })
                        .done(function(data) {
                            let options = '<option value="">All Databases</option>';
                            data.forEach(db => options += `<option value="${db}">${db}</option>`);
                            dbDropdown.html(options).prop('disabled', false);
                        })
                        .fail(function() {
                             dbDropdown.html('<option value="">Error loading</option>');
                        });
                } else {
                     dbDropdown.html('<option value="">Select Server First...</option>');
                }
            });

            // Start Trace
            $('#startTraceBtn').click(function() {
                const server = $('#serverDropdown').val();
                if (!server) {
                    toastManager.showError('Please select a server first.', 'Validation Error');
                    return;
                }

                isTracing = true;
                $('#noEventsMsg').show();
                updateButtons();
                $('#traceResults').fadeIn();
                
                // Poll every 2 seconds
                traceInterval = setInterval(fetchTraceData, 2000);
                fetchTraceData(); // Initial call
            });

            // Stop Trace
            $('#stopTraceBtn').click(function() {
                stopTrace();
            });

            // Reset Trace -> Clear Inputs
            $('#resetTraceBtn').click(function() {
                stopTrace();
                
                // Clear inputs
                $('#serverDropdown').val('').trigger('change');
                $('#databaseDropdown').html('<option value="">Select Server First...</option>').prop('disabled', true);
                $('#spFilter').val('');
                $('#traceType').val('query');
                
                // Uncheck toggles
                $('.toggle-switch input[type="checkbox"]').prop('checked', false);
                
                // Clear table
                $('#traceTableBody').empty();
                eventCount = 0;
                $('#eventCountBadge').text('0 Events');
                $('#traceResults').hide();
                $('#noEventsMsg').hide();
                $('#clientResultFilter').val('');
                
                toastManager.showInfo('Configuration reset.', 'Reset');
            });

             // Client Side Result Filtering
            $('#clientResultFilter').on('input', function() {
                const val = $(this).val().toLowerCase();
                const rows = $('#traceTableBody tr');
                let foundAny = false;
                let firstMatch = null;

                rows.each(function() {
                    const text = $(this).text().toLowerCase();
                    if (text.indexOf(val) > -1) {
                        $(this).show();
                        if (!firstMatch) firstMatch = $(this);
                        foundAny = true;
                    } else {
                        $(this).hide();
                    }
                });

                if (firstMatch && val.length > 0) {
                     // Scroll to first match
                     const container = $('#tableContainer');
                     const scrollTop = firstMatch.offset().top - container.offset().top + container.scrollTop();
                     container.stop().animate({ scrollTop: scrollTop }, 300);
                }
            });


            function stopTrace() {
                isTracing = false;
                if (traceInterval) clearInterval(traceInterval);
                updateButtons();
            }

            function updateButtons() {
                if (isTracing) {
                    $('#startTraceBtn').hide();
                    $('#stopTraceBtn').show().css('display', 'inline-flex');
                    $('#serverDropdown, #databaseDropdown, #spFilter').prop('disabled', true);
                } else {
                    $('#startTraceBtn').show();
                    $('#stopTraceBtn').hide();
                    $('#serverDropdown, #databaseDropdown, #spFilter').prop('disabled', false);
                }
            }

            function fetchTraceData() {
                const server = $('#serverDropdown').val();
                const db = $('#databaseDropdown').val();
                const sp = $('#spFilter').val();
                const type = $('#traceType').val();

                $.get('@Url.Action("GetTraceData", "TraceFounder")', { serverName: server, databaseName: db, spFilter: sp, traceType: type })
                    .done(function(response) {
                        if (response.success && response.data) {
                            if (response.data.length > 0) $('#noEventsMsg').hide();
                            updateTable(response.data);
                        }
                    });
            }

            function updateTable(data) {
                const tbody = $('#traceTableBody');
                
                // Filter client side if needed based on toggles
                const filterDuration = $('#filterDuration').is(':checked');
                const filterSystem = $('#filterSystem').is(':checked'); // Note: Implementation changed to Query Stats, so app name not available, ignoring for now

                data.forEach(row => {
                    // Simple distinct check to avoid spamming duplicates if query stats returns same row multiple times
                    // Ideally we track by hash, but for live view, just show incoming
                    
                    if (filterDuration && parseInt(row.duration) < 1000) return;

                    eventCount++;
                    const time = new Date(row.startTime).toLocaleTimeString();
                    
                    const tr = `
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s;">
                            <td style="padding: 1rem; white-space: nowrap;">${time}</td>
                            <td style="padding: 1rem;">${row.eventType}</td>
                            <td style="padding: 1rem;">${row.database}</td>
                            <td style="padding: 1rem; font-family: monospace; color: var(--primary-light); max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${row.textData}">${row.textData.substring(0, 100)}</td>
                            <td style="padding: 1rem; text-align: right;">${row.duration}ms</td>
                        </tr>
                    `;
                    tbody.prepend(tr);
                });

                // Limit rows for performance
                if (tbody.children().length > 200) {
                    tbody.children().slice(200).remove();
                }

                $('#eventCountBadge').text(`${eventCount} Events Captured`);
            }
        });
    </script>
}
