@model Template_Builder.Models.ViewModels.TemplateViewModel
@{
    ViewData["Title"] = "SQL Template Generator";
}

<div class="app-container">
    <!-- Hero Section -->
    <header class="hero-section" style="margin: 3rem 0 4rem; padding: 0;">
        <div class="hero-content">
            <div class="hero-icon" style="width: 72px; height: 72px; margin-bottom: 1.5rem;">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 36px; height: 36px;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                </svg>
            </div>
            <h1 class="hero-title" style="font-size: 2.5rem; margin-bottom: 0.75rem;">SQL Template Generator</h1>
            <p class="hero-subtitle" style="font-size: 1.1rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto;">Standardized, production-grade SQL scripts for seamless deployments.</p>
        </div>
    </header>

    <!-- Main Form Card -->
    <section class="main-card" aria-labelledby="config-title">
        <div class="card-header" style="padding: 2rem 3rem; background: rgba(15, 23, 42, 0.4);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h2 id="config-title" class="card-title" style="font-size: 1.5rem; margin-bottom: 0.5rem;">Configuration</h2>
                    <p class="card-subtitle">Define target environment and template parameters</p>
                </div>
            </div>
        </div>

        <div class="card-body" style="padding: 3rem;">
            <form id="generateForm">
                @Html.AntiForgeryToken()
                
                <!-- Professional Grid Layout -->
                <div class="form-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; align-items: start;">
                    <!-- Server Dropdown -->
                    <div class="form-group animate-fade-up delay-100">
                        <label for="serverDropdown" class="form-label form-label-required">Server</label>
                        <div class="input-wrapper">
                            <select id="serverDropdown" name="SelectedServer" class="form-select" required>
                                <option value="">Select Server...</option>
                                @foreach (var server in Model.Servers)
                                {
                                    <option value="@server.Name">@server.Name</option>
                                }
                            </select>
                            <div class="input-icon">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Database Dropdown -->
                    <div class="form-group animate-fade-up delay-200">
                        <label for="databaseDropdown" class="form-label form-label-required">Database</label>
                        <div class="input-wrapper">
                            <select id="databaseDropdown" name="SelectedDatabase" class="form-select" required>
                                <option value="">Select Database...</option>
                            </select>
                            <div class="input-icon">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Template Type Dropdown -->
                    <div class="form-group animate-fade-up delay-300">
                        <label for="templateType" class="form-label form-label-required">Type</label>
                        <div class="input-wrapper">
                            <select id="templateType" name="TemplateType" class="form-select" required>
                                <option value="">Select Type...</option>
                                <option value="data">Store procedure - Function </option>
                                <option value="insertupdate">Insert/Update (Single Row)</option>
                                <option value="bulkinsert">Bulk Insert (CSV Upload)</option>
                                @foreach (var templateType in Model.AvailableTemplateTypes)
                                {
                                    /* Hiding default loop if hardcoding options for better control or new types non-db backed */
                                }
                            </select>
                            <div class="input-icon">
                                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Ticket Number Input -->
                    <div class="form-group animate-fade-up delay-400">
                        <label for="ticketNumber" class="form-label form-label-required">Ticket #</label>
                        <div class="input-wrapper">
                            <input type="text" id="ticketNumber" name="TicketNumber"
                                   placeholder="TICKET-12345"
                                   class="form-input" required>
                        </div>
                    </div>
                </div>



                <!-- Insert/Update Data Template Section -->
                <div id="insertUpdateTemplateSection" class="template-section" style="margin-top: 3rem;">
                    <h3 class="template-section-title">
                        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
                        </svg>
                        Table Data & Import
                    </h3>

                    <!-- Table Name Row -->
                    <div class="form-grid" style="grid-template-columns: 1fr; margin-bottom: 2.5rem;">
                        <div class="form-group">
                            <label for="tableName" class="form-label form-label-required">Table Name</label>
                            <input type="text" id="tableName" name="TableName"
                                   placeholder="e.g. dbo.Users"
                                   class="form-input">
                        </div>
                    </div>

                    <!-- Dynamic Columns -->
                    <div id="tableColumnsContainer"></div>
                    
                    <div id="upsertKeysContainer" class="form-group" style="margin-top: 1.5rem;">
                         <label for="csvWhereCols" class="form-label">Upsert Keys (Optional)</label>
                         <input type="text" id="csvWhereCols" class="form-input" placeholder="e.g. Code, TenantID">
                         <div class="form-hint" style="font-size: 0.8rem;">Columns to check for duplicates (comma-separated).</div>
                    </div>

                    <!-- CSV Import Panel -->
                    <div id="bulkUploadContainer" class="form-group" style="margin-top: 3rem; background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(148, 163, 184, 0.1); border-radius: var(--radius-lg); padding: 2rem;">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
                            <div style="background: rgba(139, 92, 246, 0.1); padding: 8px; border-radius: 8px;">
                                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--primary-light);">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 style="font-size: 1.1rem; font-weight: 600; color: var(--text-main); margin: 0;">Bulk Upload (CSV)</h4>
                                <p style="font-size: 0.85rem; color: var(--text-tertiary); margin-top: 2px;">Upload a CSV file to automatically map columns and values.</p>
                            </div>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;">
                            <!-- File Upload -->
                            <div class="form-group" style="grid-column: span 2;">
                                <label class="form-label" style="margin-bottom: 1rem;">Upload Data Source</label>
                                <div id="dropZone" class="file-upload-zone">
                                    <input type="file" id="csvFile" accept=".csv" class="file-upload-input">
                                    <label for="csvFile" class="file-upload-label">
                                        <div class="default-state">
                                            <svg class="file-upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                            </svg>
                                            <div style="font-weight: 600; color: var(--text-main);">Choose a CSV file or drag & drop</div>
                                            <div style="font-size: 0.85rem; color: var(--text-tertiary);">Max size 10MB</div>
                                        </div>

                                        <!-- Uploading State -->
                                        <div class="uploading-state" style="display: none; width: 100%; max-width: 300px;">
                                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.875rem; color: var(--text-secondary);">
                                                <span>Uploading...</span>
                                                <span class="upload-percent">0%</span>
                                            </div>
                                            <div class="progress-bar-container" style="height: 6px; background: rgba(255,255,255,0.1); border-radius: 99px; overflow: hidden;">
                                                <div class="progress-bar-fill" style="height: 100%; width: 0%; background: var(--primary-color); transition: width 0.2s ease;"></div>
                                            </div>
                                        </div>

                                        <!-- Success State -->
                                        <div class="success-state" style="display: none; text-align: center;">
                                            <div style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                                                <svg width="24" height="24" fill="none" stroke="#10b981" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                            </div>
                                            <div id="fileNameDisplay" style="font-weight: 600; color: var(--text-main); margin-bottom: 0.25rem;"></div>
                                            <div id="fileSizeDisplay" style="font-size: 0.85rem; color: var(--text-tertiary);"></div>
                                            <button type="button" class="btn-remove-file" id="removeFileBtn">Remove File</button>
                                        </div>
                                    </label>
                                </div>
                            </div>


                        </div>

                        <!-- Idempotent Checkbox -->
                        <div class="checkbox-group" style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.05); display: flex; align-items: flex-start; gap: 1rem;">
                            <input type="checkbox" id="useIdempotent" class="checkbox-input" checked style="margin-top: 0.3rem;">
                            <div>
                                <label for="useIdempotent" style="font-weight: 600; color: var(--text-main); cursor: pointer; font-size: 1rem;">Enable Smart Upsert Mode</label>
                                <div class="form-hint" style="margin-top: 0.5rem; line-height: 1.5;">
                                    Generates an idempotent script `IF NOT EXISTS INSERT ELSE UPDATE`.
                                    <br>Automaticaly handles <code>ID</code> generation and Audit fields (<code>CreatedDate</code>, <code>UpdatedBy</code>).
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Object Names -->
                <div id="sqlObjectsSection" class="form-group animate-fade-up delay-500" style="display: none;">
                    <label for="objectNames" class="form-label form-label-required">SQL Objects</label>
                    <textarea id="objectNames" name="ObjectNamesText"
                           placeholder="e.g. dbo.usp_GetUser, [dbo].[fn_CalcValue], tbl_Users"
                           class="form-input form-textarea" rows="3"></textarea>
                    <div class="form-hint">
                        Objects will be automatically formatted with brackets
                    </div>
                </div>

                <!-- Buttons -->
                <div class="button-group">
                    <button type="button" id="clearSelectionsBtn" class="btn btn-secondary">
                        Clear
                    </button>
                    
                    <button type="button" id="generateBtn" class="btn btn-primary">
                        <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                        Generate Template
                    </button>

                    <button type="button" id="downloadBtn" class="btn btn-success" style="display: none;">
                        <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Download SQL
                    </button>
                </div>
            </form>
        </div>
    </section>



    <!-- Results Section -->
    <section id="resultsSection" class="results-section" style="display: none;">
        <div class="results-card">
            <div class="results-header">
                <h3 class="results-title">
                    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Generated SQL Template
                    <span class="results-badge" id="resultsBadge" style="margin-left: 1rem;">
                        <!-- Type inserted here -->
                    </span>
                </h3>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <span class="results-badge" style="background: rgba(16, 185, 129, 0.1); color: var(--success-color); border-color: rgba(16, 185, 129, 0.2);">Ready to Download</span>
                    
                    <!-- Copy Button -->
                    <button type="button" class="copy-btn" onclick="copyToClipboard(this)" title="Copy SQL to Clipboard">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                        </svg>
                        Copy Code
                    </button>
                </div>
            </div>
            <div class="code-container">
                <pre class="code-content" id="finalCode"></pre>
            </div>
        </div>
    </section>

    <footer class="app-footer">
        <p>&copy; @DateTime.Now.Year - SQL Template Generator. Built for precision.</p>
    </footer>
</div>

