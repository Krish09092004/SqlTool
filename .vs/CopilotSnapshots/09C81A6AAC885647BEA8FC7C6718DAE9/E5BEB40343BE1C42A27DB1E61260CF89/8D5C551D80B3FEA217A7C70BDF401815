    async performDownload(requestData) {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const response = await fetch('/Home/DownloadTemplate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(requestData)
            });

            if (response.ok) {
                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = `#${requestData.TicketNumber.toUpperCase()}_${requestData.TemplateType}.sql`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);

                if (this.toastManager && this.toastManager.showSuccess) {
                    this.toastManager.showSuccess('Template downloaded successfully!');
                }
            } else {
                throw new Error('Download failed');
            }
        } catch (error) {
            console.error('Download error:', error);
            if (this.toastManager && this.toastManager.showError) {
                this.toastManager.showError('Failed to download template');
            }
        }
    }

    clearSelections() {
        if (confirm('Are you sure you want to clear all selections?')) {
            this.storage.clear();

            // Reset form fields
            $('#serverDropdown').val('');
            $('#databaseDropdown').html('<option value="">-- Select Database --</option>');
            $('#templateType').val('');
            $('#ticketNumber').val('').removeClass('input-success input-error');
            $('#objectNames').val('').removeClass('input-success input-error');
            $('#tableName').val('');

            // Clear CSV
            $('#csvFile').val('');
            $('#useIdempotent').prop('checked', false);
            this.csvContent = null;
            $('.column-input').prop('disabled', false);

            // Clear config rows
            $('#configRowsContainer').empty();
            this.configRowCounter = 1;

            // Clear table columns
            $('#tableColumnsContainer').html('');

            // Hide sections
            $('.template-section').removeClass('active');
            $('#sqlObjectsSection').show();
            $('#resultsSection').remove();
            $('#downloadBtn').hide();

            // Reset button state
            this.checkGenerateButton();

            if (this.toastManager && this.toastManager.showSuccess) {
                this.toastManager.showSuccess('All selections cleared!');
            }
        }
    }
}

// Make it available globally
window.TemplateGenerator = TemplateGenerator;