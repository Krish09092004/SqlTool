    validateBulkData() {
        if (!this.csvContent || !this.currentTableColumns) return { isValid: true };

        const rows = this.csvContent.split(/\r?\n/).filter(row => row.trim());
        if (rows.length === 0) return { isValid: false, error: 'CSV file is empty' };

        // Define audit columns to ignore
        const auditColumns = ['createddate', 'createdby', 'updateddate', 'updatedby'];

        // Filter table columns: exclude identity and audit columns
        const validTableColumns = this.currentTableColumns.filter(c =>
            !c.isIdentity &&
            !auditColumns.includes(c.columnName.toLowerCase())
        );

        // check if upsert keys are included? 
        // User requirements: "total column ... should equal to the number of input"

        const inputColumnCount = rows[0].split(',').length;

        if (inputColumnCount !== validTableColumns.length) {
            return {
                isValid: false,
                error: `Column count mismatch.CSV has ${inputColumnCount} columns, but table requires ${validTableColumns.length} (excluding audit fields: CreatedDate, CreatedBy, UpdatedDate, UpdatedBy).`
            };
        }

        // Validate types for all rows (skipping header if it exists? assuming no header for raw data or header matches? 
        // Usually bulk insert CSVs include a header. Let's assume row 0 is header and validate from row 1.
        // But if user didn't provide header, we might skip valid data.
        // However, standard practice is header.
        // Let's validate ALL rows, if row 0 fails, we assumes it's header and ignore it?
        // Or simply iterate starting from 1 if rows > 1.

        let startRow = 1;
        if (rows.length === 1) startRow = 0; // If only 1 row, treat as data? Or header? Ambiguous.

        // Optimization: if file is huge, maybe validate first 100 rows? "verify all" said user.
        // We'll validate up to 1000 rows to be safe on performance, or all if small.
        const maxRows = rows.length;

        for (let i = startRow; i < maxRows; i++) {
            const cells = rows[i].split(','); // Simple split

            if (cells.length !== validTableColumns.length) {
                return { isValid: false, error: `Row ${i + 1} has invalid column count.Expected ${validTableColumns.length}, found ${cells.length}.` };
            }

            for (let j = 0; j < validTableColumns.length; j++) {
                const col = validTableColumns[j];
                const rawVal = cells[j].trim();

                // Helper to validate type
                if (!this.isValidBulkValue(rawVal, col)) {
                    return { isValid: false, error: `Validation failed at Row ${i + 1}, Column '${col.columnName}': Value '${rawVal}' is invalid for type ${col.dataType}.` };
                }
            }
        }

        return { isValid: true };
    }

    isValidBulkValue(val, col) {
        // Handle Nulls
        if (!val || val === '' || val.toLowerCase() === 'null') {
            return col.isNullable === 'YES';
        }

        const type = col.dataType.toLowerCase();

        if (type.includes('int') || type.includes('bigint') || type.includes('smallint') || type.includes('tinyint')) {
            return /^-?\d+$/.test(val);
        }

        if (type.includes('decimal') || type.includes('numeric') || type.includes('money') || type.includes('float')) {
            return /^-?\d*\.?\d+$/.test(val);
        }

        if (type.includes('bit')) {
            return /^(true|false|0|1)$/i.test(val);
        }

        if (type.includes('date') || type.includes('time')) {
            // Simple date check? Date.parse?
            return !isNaN(Date.parse(val));
        }

        return true; // Varchar etc assume valid
    }

    debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    async generateTemplate() {
        try {
            const requestData = this.collectFormData();

            // Validate required fields
            if (!this.validateFormData(requestData)) {
                if (this.toastManager && this.toastManager.showError) {
                    this.toastManager.showError('Please fill all required fields');
                }
                return;
            }

            // Bulk Insert Verification
            if (this.currentTableColumns && requestData.TemplateType === 'bulkinsert') {
                const validation = this.validateBulkData();
                if (!validation.isValid) {
                    if (this.toastManager && this.toastManager.showError) {
                        this.toastManager.showError(validation.error);
                    }
                    return;
                }
            }

            this.showLoadingState();

            const response = await this.apiCall('POST', '/Home/GenerateTemplate', requestData);

            if (response.success) {
                this.generatedTemplateContent = response.template;
                this.displayGeneratedTemplate(response.template);
                if (this.toastManager && this.toastManager.showSuccess) {
                    this.toastManager.showSuccess('Template generated successfully!');
                }
            } else {
                if (this.toastManager && this.toastManager.showError) {
                    this.toastManager.showError(response.error || 'Failed to generate template');
                }
            }
        } catch (error) {
            console.error('Error generating template:', error);
            if (this.toastManager && this.toastManager.showError) {
                this.toastManager.showError('An error occurred while generating the template');
            }
        } finally {
            this.hideLoadingState();
        }
    }

