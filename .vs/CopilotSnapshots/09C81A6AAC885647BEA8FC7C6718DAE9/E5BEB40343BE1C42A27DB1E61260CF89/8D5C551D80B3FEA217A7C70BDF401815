class TemplateGenerator {
    constructor() {
        this.configRowCounter = 1;
        this.foreignKeyCounter = 0;
        this.currentEventSource = null;
        this.generatedTemplateContent = '';
        this.csvContent = null;
        this.storage = this.createStorage();
        this.toastManager = window.toastManager;

        this.templateConfig = {
            [CONSTANTS.TEMPLATE_TYPES.CONFIG]: {
                section: '#configTemplateSection',
                requiredFields: [CONSTANTS.SELECTORS.CLASSES.CONFIG_CODE, CONSTANTS.SELECTORS.CLASSES.CONFIG_VALUE1],
                hideObjects: true
            },
            [CONSTANTS.TEMPLATE_TYPES.PERMISSION]: {
                section: null,
                requiredFields: [],
                hideObjects: false
            },
            [CONSTANTS.TEMPLATE_TYPES.DATA]: {
                section: null,
                requiredFields: [],
                hideObjects: false
            },
            [CONSTANTS.TEMPLATE_TYPES.INSERT_UPDATE]: {
                section: '#insertUpdateTemplateSection',
                requiredFields: [CONSTANTS.SELECTORS.DROPDOWNS.TABLE_NAME],
                hideObjects: true
            },
            [CONSTANTS.TEMPLATE_TYPES.SP]: {
                section: null,
                requiredFields: [],
                hideObjects: false
            }
        };

        this.init();
    }

    createStorage() {
        return {
            set: function (key, value) {
                try {
                    sessionStorage.setItem(key, JSON.stringify(value));
                } catch (e) {
                    console.warn('Session storage not available');
                }
            },
            get: function (key) {
                try {
                    const item = sessionStorage.getItem(key);
                    return item ? JSON.parse(item) : null;
                } catch (e) {
                    console.warn('Session storage not available');
                    return null;
                }
            },
            remove: function (key) {
                try {
                    sessionStorage.removeItem(key);
                } catch (e) {
                    console.warn('Session storage not available');
                }
            },
            clear: function () {
                try {
                    sessionStorage.clear();
                } catch (e) {
                    console.warn('Session storage not available');
                }
            }
        };
    }

    init() {
        this.bindEvents();
        this.initializeSelections();
    }

    bindEvents() {
        $(CONSTANTS.SELECTORS.DROPDOWNS.SERVER).on('change', () => this.onServerChange());
        $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).on('change', () => this.onDatabaseChange());
        $(CONSTANTS.SELECTORS.DROPDOWNS.TEMPLATE_TYPE).on('change', () => this.onTemplateTypeChange());
        // Use internal debounce for better control and consistency
        $(CONSTANTS.SELECTORS.DROPDOWNS.TABLE_NAME).on('input', this.debounce(() => this.onTableNameChange(), 1000));


        $(CONSTANTS.SELECTORS.INPUTS.CSV_FILE).on('change', (e) => this.onCsvFileChange(e));

        $(CONSTANTS.SELECTORS.INPUTS.TICKET_NUMBER).on('input', () => this.validateTicketNumber());
        $(CONSTANTS.SELECTORS.INPUTS.OBJECT_NAMES).on('input', () => this.validateObjects());

        $(CONSTANTS.SELECTORS.BUTTONS.GENERATE).on('click', () => this.generateTemplate());
        $(CONSTANTS.SELECTORS.BUTTONS.DOWNLOAD).on('click', () => this.downloadTemplate());

        $(CONSTANTS.SELECTORS.BUTTONS.ADD_CONFIG_ROW).on('click', () => this.addConfigRow());
        $(CONSTANTS.SELECTORS.BUTTONS.CLEAR_SELECTIONS).on('click', () => this.clearSelections());

        $(document).on('click', CONSTANTS.SELECTORS.CLASSES.REMOVE_CONFIG_ROW, (e) => this.removeConfigRow(e.currentTarget));
    }

    async apiCall(method, url, data = null) {
        const token = document.querySelector(CONSTANTS.SELECTORS.INPUTS.REQUEST_VERIFICATION_TOKEN).value;
        const options = {
            method: method,
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': token
            }
        };

        if (data) {
            options.body = JSON.stringify(data);
        }

        try {
            const response = await fetch(url, options);

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            return await response.json();
        } catch (error) {
            console.error('API call failed:', error);
            throw error;
        }
    }

    async onServerChange() {
        const serverName = $(CONSTANTS.SELECTORS.DROPDOWNS.SERVER).val();
        console.log('Server changed to:', serverName);

        this.storage.set(CONSTANTS.STORAGE_KEYS.SELECTED_SERVER, serverName);

        // Disable to prevent race conditions
        const $serverDropdown = $(CONSTANTS.SELECTORS.DROPDOWNS.SERVER);
        $serverDropdown.prop('disabled', true);

        if (this.toastManager && this.toastManager.showInfo) {
            this.toastManager.showInfo('Loading databases, please wait...');
        }

        if (!serverName) {
            $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).html('<option value="">-- Select Database --</option>');
            $serverDropdown.prop('disabled', false);
            this.checkGenerateButton();
            return;
        }

        $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).html('<option value="">-- Loading databases... --</option>').prop('disabled', true);

        try {
            const databases = await this.apiCall('GET', `${CONSTANTS.API.GET_DATABASES}?serverName=${encodeURIComponent(serverName)}`);
            this.populateDatabases(databases);
            if (this.toastManager && this.toastManager.showSuccess) {
                this.toastManager.showSuccess(CONSTANTS.MESSAGES.DATABASES_LOADED);
            }
        } catch (error) {
            console.error('Error loading databases:', error);
            if (this.toastManager && this.toastManager.showError) {
                this.toastManager.showError(CONSTANTS.MESSAGES.DATABASES_LOAD_ERROR);
            }
            $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).html('<option value="">-- Error loading databases --</option>');
        } finally {
            $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).prop('disabled', false);
            $(CONSTANTS.SELECTORS.DROPDOWNS.SERVER).prop('disabled', false);
            this.checkGenerateButton();
        }
    }

    async onDatabaseChange() {
        const databaseName = $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).val();
        this.storage.set(CONSTANTS.STORAGE_KEYS.SELECTED_DATABASE, databaseName);
        this.checkGenerateButton();

        // Reload table columns if table name exists
        const tableName = $(CONSTANTS.SELECTORS.DROPDOWNS.TABLE_NAME).val();
        if (tableName) {
            await this.loadTableColumns(tableName.trim());
        }
    }

    onTemplateTypeChange() {
        const templateType = $(CONSTANTS.SELECTORS.DROPDOWNS.TEMPLATE_TYPE).val();
        this.storage.set(CONSTANTS.STORAGE_KEYS.TEMPLATE_TYPE, templateType);
        this.showTemplateSection(templateType);
        this.checkGenerateButton();
    }

    showTemplateSection(templateType) {
        $(CONSTANTS.SELECTORS.CLASSES.TEMPLATE_SECTION).removeClass(CONSTANTS.SELECTORS.CLASSES.ACTIVE);

        // Hide by default
        $(CONSTANTS.SELECTORS.CONTAINERS.SQL_OBJECTS_SECTION).hide();

        if (templateType) {
            // Logic for specific templates that DO NOT need SQL Objects
            if (templateType === CONSTANTS.TEMPLATE_TYPES.CONFIG ||
                templateType === CONSTANTS.TEMPLATE_TYPES.INSERT_UPDATE ||
                templateType === CONSTANTS.TEMPLATE_TYPES.BULK_INSERT) {
                $(CONSTANTS.SELECTORS.CONTAINERS.SQL_OBJECTS_SECTION).hide();
            } else {
                // For SP, DATA, PERMISSION etc. show it
                $(CONSTANTS.SELECTORS.CONTAINERS.SQL_OBJECTS_SECTION).fadeIn();
            }

            // Show specific section
            // For Bulk Insert, we reuse the 'insertupdate' section (Table + CSV)
            const typeKey = templateType === CONSTANTS.TEMPLATE_TYPES.BULK_INSERT
                ? CONSTANTS.TEMPLATE_TYPES.INSERT_UPDATE
                : templateType;

            if (this.templateConfig[typeKey]) {
                const section = this.templateConfig[typeKey].section;
                if (section) {
                    $(section).addClass(CONSTANTS.SELECTORS.CLASSES.ACTIVE);
                }
            }
        }

        // FIX: Initialize config section with one row when config template is selected
        if (templateType === CONSTANTS.TEMPLATE_TYPES.CONFIG && $(`${CONSTANTS.SELECTORS.CONTAINERS.CONFIG_ROWS} ${CONSTANTS.SELECTORS.CLASSES.CONFIG_ROW}`).length === 0) {
            this.addConfigRow();
        }

        // Handle specific UI elements for Bulk Insert vs Insert/Update
        if (templateType === CONSTANTS.TEMPLATE_TYPES.BULK_INSERT) {
            // Hide manual column inputs, show only Table + CSV
            $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).hide();
            $('.btn-add-row').hide(); // Assuming there's an add row button for manual entry if exists
            $(CONSTANTS.SELECTORS.CONTAINERS.BULK_UPLOAD).show();
        } else if (templateType === CONSTANTS.TEMPLATE_TYPES.INSERT_UPDATE) {
            $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).show();
            $(CONSTANTS.SELECTORS.CONTAINERS.BULK_UPLOAD).hide();
        }

        this.checkGenerateButton();
    }

    populateDatabases(databases) {
        let options = '<option value="">-- Select Database --</option>';
        if (databases && databases.length > 0) {
            databases.forEach(db => {
                options += `<option value="${db}">${db}</option>`;
            });
        } else {
            options = '<option value="">-- No databases found --</option>';
        }
        $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).html(options);
    }

    getTemplateTypeDisplayName(templateType) {
        const types = {
            'config': 'Configuration Template',
            'permission': 'Permission Template',
            'data': 'Data Template',
            'insertupdate': 'Insert/Update Data Template',
            'sp': 'Stored Procedure Template',
            'bulkinsert': 'Bulk Insert Template'
        };
        return types[templateType] || 'SQL Template';
    }

    async onTableNameChange() {
        let tableName = $(CONSTANTS.SELECTORS.DROPDOWNS.TABLE_NAME).val();

        // Auto-trim to avoid issues with copy-paste spaces
        if (tableName) {
            tableName = tableName.trim();
        }

        this.storage.set(CONSTANTS.STORAGE_KEYS.TABLE_NAME, tableName);

        if (tableName && tableName.length > 0) {
            await this.loadTableColumns(tableName);
        } else {
            $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).html('');
            this.checkGenerateButton();
        }
    }

    async loadTableColumns(tableName) {
        if (tableName) tableName = tableName.trim();
        const server = $(CONSTANTS.SELECTORS.DROPDOWNS.SERVER).val();
        const database = $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).val();

        if (!server || !database) {
            return;
        }

        $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).html(`
            <div class="loading-table">
                <span class="spinner"></span> Loading table columns...
            </div>
        `);

        try {
            const columns = await this.apiCall('GET',
                `${CONSTANTS.API.GET_TABLE_COLUMNS}?serverName=${encodeURIComponent(server)}&databaseName=${encodeURIComponent(database)}&tableName=${encodeURIComponent(tableName)}`);

            // Prevent race condition: ensure selection hasn't changed
            const currentServer = $(CONSTANTS.SELECTORS.DROPDOWNS.SERVER).val();
            const currentDatabase = $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).val();
            // Note: TableName might differ if we support multi-table, but for single dropdown:
            const currentTable = $(CONSTANTS.SELECTORS.DROPDOWNS.TABLE_NAME).val();

            if (server !== currentServer || database !== currentDatabase || tableName !== currentTable) {
                console.warn('Selection changed during column load, ignoring result.');
                return;
            }

            this.currentTableColumns = columns;
            this.renderTableColumns(columns);
        } catch (error) {
            console.error('Error loading table columns:', error);

            // Provide more specific feedback
            // If the error message suggests not found (based on typical 404 or backend message)
            let errorMessage = 'Error loading table structure. Please check your connection and table name.';
            let isNotFound = error.message && (error.message.includes('404') || error.message.includes('not found'));

            if (isNotFound) {
                errorMessage = `Table '${tableName}' not found. Please check the spelling.`;
                $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).html(`
                    <div class="table-not-found" style="color: #6b7280; border-color: #e5e7eb;">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        ${errorMessage}
                    </div>
                `);
            } else {
                // Critical error
                $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).html(`
                    <div class="table-not-found">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        ${errorMessage}
                    </div>
                `);
            }
        }

        this.checkGenerateButton();
    }

    renderTableColumns(columns) {
        if (!columns || columns.length === 0) {
            $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).html(`
                <div class="table-not-found">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Table not found or no columns available. Please check the table name.
                </div>
                `);
            return;
        }

        let html = '<div class="table-columns-grid">';

        columns.forEach(column => {
            if (column.isIdentity) return;

            const isRequired = column.isNullable === 'NO' && !column.isIdentity;
            const isPk = column.isPrimaryKey;
            const inputType = this.getInputTypeForDataType(column.dataType);
            const placeholder = isPk ? 'Auto-generated if empty' : this.getPlaceholderForDataType(column.dataType);

            // Card classes
            let cardClasses = 'column-card';
            if (isPk) cardClasses += ' primary-key';
            else if (isRequired) cardClasses += ' required-field';

            html += `
                <div class="${cardClasses}">
                    <div class="column-header">
                        <div class="column-info">
                            <span class="column-name">
                                ${column.columnName}
                                ${isPk ? '<span class="pk-badge">PK</span>' : ''}
                            </span>
                            <span class="column-meta">
                                ${column.dataType}${column.maxLength ? `(${column.maxLength})` : ''} 
                                ${column.isNullable === 'YES' ? '(null)' : '(not null)'}
                            </span>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        ${inputType === 'checkbox' ? `
                            <div class="toggle-wrapper" style="background: transparent; padding: 0; margin-top: 0.5rem; justify-content: flex-start; gap: 1rem;">
                                <label class="toggle-switch toggle-success">
                                    <input type="checkbox"
                                        name="TableData.${column.columnName}"
                                        class="checkbox-input column-input bit-value-toggle"
                                        data-type="${column.dataType}"
                                        data-is-nullable="${column.isNullable === 'YES'}"
                                        data-is-primary-key="${column.isPrimaryKey}"
                                        ${isRequired ? 'required' : ''}>
                                    <span class="slider"></span>
                                </label>
                                <span class="bit-value-label" style="font-size: 0.9rem; font-weight: 500; min-width: 40px; color: var(--text-muted);">False</span>
                            </div>
                        ` : `
                            <input type="${inputType}"
                                name="TableData.${column.columnName}"
                                class="form-input column-input"
                                placeholder="${placeholder}"
                                data-type="${column.dataType}"
                                data-is-nullable="${column.isNullable === 'YES'}"
                                data-is-primary-key="${column.isPrimaryKey}"
                                ${isRequired ? 'required' : ''}>
                        `}
                    </div>

                    <div class="toggle-wrapper">
                        <span class="toggle-label">Use in WHERE clause</span>
                        <label class="toggle-switch">
                            <input type="checkbox" 
                                   id="where_${column.columnName}" 
                                   class="where-condition-checkbox"
                                   data-column="${column.columnName}"
                                   ${isPk ? 'checked' : ''}>
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>
                `;
        });

        html += '</div>';

        $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).html(html);

        // Add event listeners
        $(CONSTANTS.SELECTORS.CLASSES.COLUMN_INPUT).on('input change', (e) => this.onColumnInputChange(e.target));
        $(CONSTANTS.SELECTORS.CLASSES.WHERE_CHECKBOX).on('change', () => this.onWhereCheckboxChange());

        // Bit Toggle Listener
        $(CONSTANTS.SELECTORS.CLASSES.BIT_VALUE_TOGGLE).on('change', function () {
            const isChecked = $(this).is(':checked');
            const $label = $(this).closest('.toggle-wrapper').find('.bit-value-label');
            $label.text(isChecked ? 'True' : 'False');
            $label.css('color', isChecked ? 'var(--success-color)' : 'var(--text-muted)');
        });

        // Load saved data
        this.loadTableData();

        // Trigger change to update labels after load
        $(CONSTANTS.SELECTORS.CLASSES.BIT_VALUE_TOGGLE).trigger('change');

        this.updateWhereConditionSummary();
    }

    getInputTypeForDataType(dataType) {
        const typeMap = {
            'bit': 'checkbox',
            'int': 'number',
            'bigint': 'number',
            'smallint': 'number',
            'tinyint': 'number',
            'decimal': 'number',
            'numeric': 'number',
            'float': 'number',
            'real': 'number',
            'money': 'number',
            'smallmoney': 'number',
            'date': 'date',
            'datetime': 'datetime-local',
            'datetime2': 'datetime-local',
            'smalldatetime': 'datetime-local',
            'time': 'time'
        };

        return typeMap[dataType.toLowerCase()] || 'text';
    }

    getPlaceholderForDataType(dataType) {
        const placeholderMap = {
            'varchar': 'Enter text...',
            'nvarchar': 'Enter text...',
            'char': 'Enter text...',
            'nchar': 'Enter text...',
            'text': 'Enter text...',
            'ntext': 'Enter text...',
            'int': 'Enter number...',
            'bigint': 'Enter number...',
            'decimal': 'Enter decimal...',
            'numeric': 'Enter number...',
            'float': 'Enter decimal...',
            'datetime': 'Select date and time...',
            'date': 'Select date...',
            'bit': 'True/False'
        };

        return placeholderMap[dataType.toLowerCase()] || 'Enter value...';
    }

    onColumnInputChange(input) {
        this.validateColumnInput(input);
        this.saveTableData();
        this.checkGenerateButton();
    }

    onWhereCheckboxChange() {
        this.saveTableData();
        this.checkGenerateButton();
        this.updateWhereConditionSummary();
    }

    validateColumnInput(input) {
        const $input = $(input);
        const value = $input.val();
        const dataType = $input.data('type');
        const isNullable = $input.data('is-nullable');

        // Clear previous validation
        $input.removeClass('input-error input-success');

        if (!value && !isNullable) {
            $input.addClass('input-error');
            return false;
        }

        // Basic type validation
        if (value) {
            switch (dataType.toLowerCase()) {
                case 'int':
                case 'bigint':
                case 'smallint':
                case 'tinyint':
                    if (!/^-?\d+$/.test(value)) {
                        $input.addClass('input-error');
                        return false;
                    }
                    break;
                case 'decimal':
                case 'numeric':
                case 'float':
                case 'real':
                    if (!/^-?\d*\.?\d+$/.test(value)) {
                        $input.addClass('input-error');
                        return false;
                    }
                    break;
                case 'bit':
                    if (!/^(true|false|0|1)$/i.test(value)) {
                        $input.addClass('input-error');
                        return false;
                    }
                    break;
            }
        }

        $input.addClass('input-success');
        return true;
    }

    updateWhereConditionSummary() {
        const selectedColumns = [];
        $(`${CONSTANTS.SELECTORS.CLASSES.WHERE_CHECKBOX}:checked`).each(function () {
            selectedColumns.push($(this).data('column'));
        });

        // Ensure element exists if not present
        let summaryElement = $(CONSTANTS.SELECTORS.CONTAINERS.WHERE_CONDITION_SUMMARY);
        if (!summaryElement.length && $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).length) {
            // Create summary relative to table container if missing
            $(CONSTANTS.SELECTORS.CONTAINERS.TABLE_COLUMNS).before(`
                <div id="whereConditionSummary" class="dynamic-section" style="margin-bottom:1rem; padding:1rem; background:rgba(30,41,59,0.5); border-radius:8px; border:1px solid rgba(255,255,255,0.05);">
                    <h4 style="margin-bottom: 8px; font-size:1rem; display: flex; align-items: center; gap: 8px;">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                        </svg>
                        Where Condition Columns
                    </h4>
                    <div class="form-hint">
                        <strong>Selected keys:</strong>
                        <span id="selectedWhereColumnsList" style="color: var(--primary-light); font-weight: 600; font-family:monospace;"></span>
                    </div>
                </div>
                `);
            summaryElement = $(CONSTANTS.SELECTORS.CONTAINERS.WHERE_CONDITION_SUMMARY);
        }

        const selectedList = selectedColumns.length > 0
            ? selectedColumns.join(', ')
            : '<span style="color: var(--text-muted); font-style:italic;">Auto-detect (Primary Key)</span>';

        $(CONSTANTS.SELECTORS.CONTAINERS.SELECTED_WHERE_COLUMNS_LIST).html(selectedList);

        // Remove the "input-error" adding logic completely
        summaryElement.removeClass(CONSTANTS.SELECTORS.CLASSES.INPUT_ERROR);
    }

    saveTableData() {
        const tableData = this.getTableData();
        const whereClauseColumns = this.getWhereClauseColumns();
        this.storage.set(CONSTANTS.STORAGE_KEYS.TABLE_DATA, tableData);
        this.storage.set(CONSTANTS.STORAGE_KEYS.WHERE_CLAUSE_COLUMNS, whereClauseColumns);
    }

    getTableData() {
        const tableData = {};
        $(CONSTANTS.SELECTORS.CLASSES.COLUMN_INPUT).each(function () {
            const $input = $(this);
            const columnName = $input.attr('name').replace('TableData.', '');
            const rawValue = $input.attr('type') === 'checkbox' ? $input.prop('checked') : $input.val();

            // Construct object matching C# ColumnValue class
            tableData[columnName] = {
                Value: String(rawValue), // Ensure string for deserialization
                DataType: $input.data('type') || '',
                IsNullable: $input.data('is-nullable') === true,
                IsPrimaryKey: $input.data('is-primary-key') === true,
                // Fix: Removed extra space in selector
                UseInWhereClause: $(`#where_${columnName}`).is(':checked')
            };
        });
        return tableData;
    }

    getWhereClauseColumns() {
        const whereColumns = [];
        // Fix: Removed extra space in selector
        $(`${CONSTANTS.SELECTORS.CLASSES.WHERE_CHECKBOX}:checked`).each(function () {
            whereColumns.push($(this).data('column'));
        });
        return whereColumns;
    }

    loadTableData() {
        const savedData = this.storage.get(CONSTANTS.STORAGE_KEYS.TABLE_DATA) || {};
        const savedWhereColumns = this.storage.get(CONSTANTS.STORAGE_KEYS.WHERE_CLAUSE_COLUMNS) || '';

        // Load column values
        Object.keys(savedData).forEach(columnName => {
            const $input = $(`[name = "TableData.${columnName}"]`);
            if ($input.length) {
                let savedValue = savedData[columnName];
                // Handle complex object from new getTableData
                if (savedValue && typeof savedValue === 'object' && savedValue.hasOwnProperty('Value')) {
                    savedValue = savedValue.Value;
                }

                if ($input.attr('type') === 'checkbox') {
                    // Handle string "true" or boolean true
                    $input.prop('checked', savedValue === 'true' || savedValue === true);
                } else {
                    $input.val(savedValue);
                }
            }
        });

        // Load WHERE condition checkboxes
        if (savedWhereColumns) {
            let whereColumnsArray = [];
            if (Array.isArray(savedWhereColumns)) {
                whereColumnsArray = savedWhereColumns;
            } else if (typeof savedWhereColumns === 'string') {
                whereColumnsArray = savedWhereColumns.split(',');
            }

            $(CONSTANTS.SELECTORS.CLASSES.WHERE_CHECKBOX).each(function () {
                const columnName = $(this).data('column');
                $(this).prop('checked', whereColumnsArray.includes(columnName));
            });
        }
    }

    // FIX: Improved checkGenerateButton method with better validation
    checkGenerateButton() {
        const server = $(CONSTANTS.SELECTORS.DROPDOWNS.SERVER).val();
        const database = $(CONSTANTS.SELECTORS.DROPDOWNS.DATABASE).val();
